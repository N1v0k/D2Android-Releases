<?xml version="1.0" encoding="utf-8" standalone="no"?><!-- Modified by D2Android (changes 2026-10-09 to 2026-10-30). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.winlator">
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />


    <application
        android:icon="@mipmap/d2_launcher"
        android:roundIcon="@mipmap/d2_launcher"
        android:appCategory="game"
        android:isGame="true"
        android:extractNativeLibs="true"
        android:allowAudioPlaybackCapture="true"
        android:hasFragileUserData="true"
        android:fullBackupContent="@xml/d2_backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name">





        <activity android:name="com.winlator.d2.D2LaunchActivity"
            android:theme="@style/AppThemeDark"
            android:exported="true"
            android:label="@string/d2launch_label"
            android:icon="@mipmap/d2_launcher"
            android:roundIcon="@mipmap/d2_launcher"
            android:screenOrientation="user"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/d2_shortcuts"/>
        </activity>





        <activity android:name="com.winlator.d2.D2GameActivity"
            android:exported="false"
            android:theme="@style/AppThemeFullscreenDark"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation|uiMode|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc|fontWeightAdjustment|grammaticalGender"
            android:screenOrientation="userLandscape" />




        <activity android:name="com.winlator.d2.D2InstallActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="sensorPortrait"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation|uiMode|fontScale|locale|layoutDirection|colorMode|touchscreen|mcc|mnc|fontWeightAdjustment|grammaticalGender" />


        <activity android:name="com.winlator.d2.D2SettingsActivity"
            android:theme="@style/AppThemeDark"
            android:exported="true"
            android:label="@string/d2_shortcut_game_settings"
            android:screenOrientation="user"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation" />



        <activity android:name="com.winlator.d2.D2LicensesActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="user"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation" />


        <activity android:name="com.winlator.d2.D2NotifyAskActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation" />


        <activity android:name="com.winlator.d2.D2NewsActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:screenOrientation="user"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation" />

        <activity android:name="com.winlator.d2.D2BackgroundActivity"
            android:theme="@style/AppThemeDark"
            android:exported="false"
            android:label="Hintergrund-Schutz"
            android:screenOrientation="user"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation" />


        <service
            android:name="com.winlator.d2.D2KeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>
</manifest>
